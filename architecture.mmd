%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#fff', 'primaryTextColor': '#000', 'lineColor': '#666'}}}%%
graph TB
    subgraph External["External Services"]
        Binance["Binance API<br/>(WebSocket + REST)"]
        Claude["Claude API<br/>(Anthropic)"]
    end

    subgraph Data["Data Layer"]
        DuckDB[(DuckDB<br/>Market Data)]
        DataLoader["data-loader<br/>(CLI Binary)"]
    end

    subgraph Charts["charts (Main Bevy App)"]
        subgraph Core["Core Systems"]
            MainLoop["Bevy App Loop"]
            Setup["Setup System"]
            Interaction["Interaction System"]
        end

        subgraph DataMgmt["Data Management"]
            ChartDB["ChartDatabase"]
            Aggregation["Aggregation Engine<br/>+ Cache"]
            Types["Chart/Candle Types"]
        end

        subgraph Realtime["Real-time"]
            WSPlugin["WebSocket Plugin"]
            RTPlugin["Realtime Plugin"]
        end

        subgraph Render["Rendering"]
            Candlesticks["Candlestick Renderer"]
            Volume["Volume Renderer"]
            Grid["Grid & Axes"]
            Indicators["Moving Averages"]
            Crosshair["Crosshair System"]
        end

        subgraph UI["UI"]
            FPS["FPS Counter"]
            TimeframeLabel["Timeframe Label"]
            Screenshot["Screenshot System"]
        end

        BRP["Bevy Remote Protocol<br/>(HTTP :15702)"]
    end

    subgraph ChatUI["chat-ui (Bevy Plugin)"]
        ChatPlugin["ChatUiPlugin"]
        ChatLayout["Chat Layout"]
        ChatInput["Text Input"]
        ChatMessages["Message Display"]
        ClaudeClient["Claude Client<br/>(Async Task)"]
    end

    subgraph MCP["chart-mcp (MCP Server)"]
        MCPServer["MCP Server<br/>(stdio)"]
        BRPClient["BRP Client"]
        ScreenshotTool["Screenshot Tool"]
    end

    subgraph SDK["SDK Libraries"]
        AgentSDK["claude-agent-sdk-rust"]
        TextInput["bevy_ui_text_input"]
    end

    %% Data flow connections
    Binance -->|"Historical Data"| DataLoader
    DataLoader -->|"Import"| DuckDB
    DuckDB -->|"Load Candles"| ChartDB
    Binance -->|"Live Klines"| WSPlugin

    %% Chart internal flow
    ChartDB --> Types
    Types --> Aggregation
    Aggregation --> Candlesticks
    Aggregation --> Volume
    Types --> Indicators
    WSPlugin --> RTPlugin
    RTPlugin --> Types

    %% Rendering chain
    MainLoop --> Setup
    MainLoop --> Interaction
    Interaction --> Candlesticks
    Interaction --> Crosshair
    Candlesticks --> Grid
    Volume --> Grid

    %% Chat integration
    ChatPlugin --> ChatLayout
    ChatLayout --> ChatInput
    ChatLayout --> ChatMessages
    ChatInput --> ClaudeClient
    ClaudeClient -->|"API Calls"| Claude
    ClaudeClient -->|"MCP Tools"| BRP
    TextInput --> ChatInput
    AgentSDK --> ClaudeClient

    %% MCP integration
    Claude -->|"Tool Calls"| MCPServer
    MCPServer --> BRPClient
    BRPClient -->|"HTTP"| BRP
    BRP --> Screenshot
    ScreenshotTool --> BRPClient

    %% Subgraph styling
    style External fill:#2d3748,stroke:#4a5568,stroke-width:2px,color:#fff
    style Data fill:#1a365d,stroke:#2c5282,stroke-width:2px,color:#fff
